
/* ── Root ── */
.root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 20, 30);
}

/* ── Shared panel base ── */
.panel {
    align-items: center;
    justify-content: center;
    padding: 32px;
    border-radius: 16px;
    background-color: rgb(35, 35, 50);
    min-width: 320px;
}

/* ── PIN Panel ── */
.pin-panel {
    /* inherits .panel */
}

/* ── Title ── */
.title-label {
    font-size: 28px;
    color: rgb(220, 220, 240);
    -unity-font-style: bold;
    margin-bottom: 24px;
}

/* ── PIN dot/dash display ── */
.pin-display {
    font-size: 36px;
    letter-spacing: 12px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    padding: 8px 20px;
    border-width: 2px;
    border-color: rgb(100, 100, 160);
    border-radius: 8px;
    background-color: rgb(25, 25, 40);
    min-width: 200px;
}

/* ── Error message ── */
.error-text {
    font-size: 14px;
    color: rgb(255, 80, 80);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

/* ── Numpad grid ── */
.numpad {
    flex-direction: column;
    align-items: center;
    margin-top: 16px;
}

.numpad-row {
    flex-direction: row;
    margin-bottom: 10px;
}

/* ── Number buttons ── */
.numpad-btn {
    width: 70px;
    height: 70px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(220, 220, 255);
    background-color: rgb(55, 55, 80);
    border-width: 0;
    border-radius: 50%;
    margin: 0 6px;
    -unity-text-align: middle-center;
    transition-duration: 0.1s;
}

.numpad-btn:hover {
    background-color: rgb(80, 80, 120);
}

.numpad-btn:active {
    background-color: rgb(100, 100, 160);
    scale: 0.95 0.95;
}

/* ── Backspace button ── */
.backspace-btn {
    color: rgb(255, 160, 100);
}

/* ── Spacer (aligns 0 & backspace) ── */
.numpad-btn-spacer {
    width: 70px;
    height: 70px;
    margin: 0 6px;
}

/* ── Main Content ── */
.main-content {
    /* inherits .panel */
}

.welcome-label {
    font-size: 36px;
    color: rgb(100, 230, 150);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.sub-label {
    font-size: 18px;
    color: rgb(180, 180, 200);
}

/* ── Utility ── */
.hidden {
    display: none;
}
